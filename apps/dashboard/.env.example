# URL publica do Supabase e chave Publishable: podem chegar ao navegador.
NEXT_PUBLIC_SUPABASE_URL=https://example-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PUBLISHABLE_KEY

# URL canonica do dashboard, usada para callbacks. Nao e segredo.
APP_URL=https://app.example.invalid

# Segredo administrativo: usado somente pelo script local de convite.
# Nunca use NEXT_PUBLIC_, nunca importe em Client Components e nunca versione o valor real.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ONLY_IN_ENV_LOCAL

# Envio transacional de propostas. Somente server-side.
RESEND_API_KEY=re_REPLACE_ONLY_IN_ENV_LOCAL
RESEND_FROM_EMAIL=Devora Studio <propostas@example.invalid>
