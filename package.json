{
  "name": "devora-os",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.6.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "supabase:db:diff": "supabase db diff --local --schema public",
    "supabase:db:lint": "supabase db lint --local --schema public --level error --fail-on error",
    "supabase:db:push": "supabase db push --linked",
    "supabase:db:push:dry-run": "supabase db push --linked --dry-run",
    "supabase:db:reset": "supabase db reset --local",
    "supabase:db:test": "supabase test db --local",
    "supabase:migration:new": "supabase migration new",
    "supabase:migration:up": "supabase migration up --local",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:stop": "supabase stop",
    "supabase:types": "supabase gen types typescript --local --schema public > apps/dashboard/src/lib/supabase/database.types.ts",
    "supabase:types:remote": "supabase gen types typescript --linked --schema public > apps/dashboard/src/lib/supabase/database.types.ts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "jsdom": "^29.1.1",
    "prettier": "latest",
    "supabase": "2.116.0",
    "tailwindcss": "latest",
    "turbo": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
